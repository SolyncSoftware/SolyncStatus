---
import Layout from "../layouts/Layout.astro";
import StatusBoard from "../components/StatusBoard.svelte";
import { getServices } from "../lib/services";
import { checkAllServices, toStatusView } from "../lib/status";

const services = await getServices();
const statuses = await checkAllServices(services);
const initialViews = statuses.map(toStatusView);
const lastCheck = new Date();

const refreshMinutes = Number(import.meta.env.PUBLIC_STATUS_REFRESH_MINUTES) || 5;
const apiUrl = import.meta.env.PUBLIC_STATUS_API_URL ?? "";
---

<Layout title="Solync Status">
    <main class="mx-auto w-full max-w-6xl px-4 py-8 pb-20 sm:px-6 lg:px-8">
        <StatusBoard
            initialViews={initialViews}
            services={services}
            lastChecked={lastCheck.toISOString()}
            refreshMinutes={refreshMinutes}
            apiUrl={apiUrl}
            client:load
        />

        <footer class="mt-12 border-t border-accent pt-4 text-center text-[0.9rem]">
            &copy; {lastCheck.getFullYear()} Solync. All rights reserved.
        </footer>
    </main>
</Layout>
