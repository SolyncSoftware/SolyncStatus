# Client-side live refresh interval (minutes). Defaults to 5.
PUBLIC_STATUS_REFRESH_MINUTES=5

# Optional JSON endpoint returning live probe results. When set, the client
# fetches this instead of probing service URLs directly (recommended, because
# browser CORS prevents reading cross-origin HTTP status codes).
#
# Expected shape (either an array or { "services": [...] }):
# [
#   { "id": "solynclanding", "online": true, "status": 200, "error": null,
#     "responseTime": 123, "checked": "2026-01-01T00:00:00.000Z" }
# ]
PUBLIC_STATUS_API_URL=
